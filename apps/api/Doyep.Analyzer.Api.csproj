<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>$(DoyepAnalyzerUserSecretsId)</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\application\Doyep.Analyzer.Application.csproj" />
    <ProjectReference Include="..\..\src\infrastructure\Doyep.Analyzer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- For OpenAPI/Scalar documentation -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />

    <!-- For EF migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />

    <!-- For JWT authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- For ReverseProxy -->
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

</Project>

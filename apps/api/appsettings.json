{
  "AllowedHosts": "<YOUR_ALLOWED_HOSTS>",
  "ConnectionStrings": {
    "DoyepAnalyzerDb": "Host=<YOUR_DB_HOST>;Port=<YOUR_DB_PORT>;Database=<YOUR_DB_NAME>;Username=<YOUR_DB_USER>;Password=<YOUR_DB_PASSWORD>"
  },
  "Frontend": {
    "BaseUrl": "<YOUR_FRONTEND_BASE_URL>"
  },
  "Jwt": {
    "Secret": "<YOUR_SECRET>",
    "Issuer": "DoyepAnalyzer",
    "Audience": "DoyepAnalyzerAthletes",
    "ExpirationInMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RefreshToken": {
    "ExpirationInDays": 7
  },
  "Strava": {
    "ClientId": "<YOUR_CLIENT_ID>",
    "ClientSecret": "<YOUR_CLIENT_SECRET>",
    "RedirectUri": "<YOUR_REGISTERED_REDIRECT_URI>"
  }
}
